        "ss_tot = np.sum((... - np.mean(...)) ** 2)            # écarts entre mesure et moyenne\n",
        "R2 = 1 - ss_res / ss_tot\n",
        "# 3) Affichage\n",
        "print(f\"pente = {pente:.4f} | ordonnée = {ordonnee:.4f} | R² = {R2:.4f}\")"
